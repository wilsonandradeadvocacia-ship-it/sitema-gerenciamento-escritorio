DATABASE_URL="file:./dev.db"
# ANTHROPIC_API_KEY=""          # opcional: habilita sugestoes de IA reais (publicacoes, marketing, triagem)
# GOOGLE_CLIENT_ID=""           # opcional: integracao Google Calendar
# GOOGLE_CLIENT_SECRET=""
# CRON_SECRET=""                # opcional: protege /api/publicacoes/cron
# ESCAVADOR_API_TOKEN=""        # opcional: habilita busca automatica de publicacoes via Escavador
# ESCAVADOR_WEBHOOK_SECRET=""   # opcional: protege /api/publicacoes/webhook/escavador
# DJEN_PROXY_URL=""              # opcional: proxy HTTP(S)/SOCKS5 com IP brasileiro, necessario para a API gratuita do DJEN/CNJ funcionar fora do Brasil (ex: "http://usuario:senha@host:porta")
# META_APP_ID=""                 # opcional: integracao Facebook/Instagram (publicar, agendar, impulsionar)
# META_APP_SECRET=""
# PUBLIC_BASE_URL=""             # obrigatorio junto com META_* : URL publica do site (a Meta precisa buscar as imagens)
